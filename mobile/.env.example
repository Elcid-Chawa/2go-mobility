# Use your computer's LAN address for a physical phone.
EXPO_PUBLIC_API_URL=http://<LAN_IP>:5000/api/v1
EXPO_PUBLIC_RENTALS_API_URL=http://<LAN_IP>:5103/api/v1/car-rentals
EXPO_PUBLIC_MOVERS_API_URL=http://<LAN_IP>:5101/api/v1/movers
EXPO_PUBLIC_MESSAGING_URL=ws://<LAN_IP>:4000

