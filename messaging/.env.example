# Local development only: use the same access-token secret as the backend.
# In production, provide a strong secret through your deployment environment.
JWT_ACCESS_SECRET=2go_fallback_access_secret_key_32chars_min
BACKEND_API_URL=http://localhost:5000/api/v1
PORT=4000

# Required in production; generate a unique random value of at least 64 bytes.
SECRET_KEY_BASE=replace-with-a-random-secret
